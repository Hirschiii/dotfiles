[binds]
<w> = exec cp -f "$imv_current_file" ~/.cache/wallpaper && swaymsg output "*" background ~/.cache/wallpaper fill 
<m> = exec cp -f "$imv_current_file" ~/.cache/marked/
<Shift+W> = exec cp -f "$imv_current_file" /tmp/myimages
<Shift+M> = exec mkdir -p /tmp/marked_$(date +"%Y-%m-%d") && mv -f "$imv_current_file" "/tmp/marked_$(date +"%Y-%m-%d")/"
